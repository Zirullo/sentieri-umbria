84,12.39175,565],[42.6187,12.39156,567],[42.619,12.39136,564],[42.6192,12.3914,564],[42.6194,12.39144,560],[42.61973,12.39151,554],[42.62005,12.39159,546],[42.62013,12.39167,545],[42.62037,12.39175,541],[42.6206,12.39184,537],[42.62084,12.39193,533],[42.62105,12.39208,530],[42.62127,12.39223,526],[42.62135,12.39232,524],[42.62141,12.39253,521],[42.62137,12.39266,520],[42.62121,12.3929,520],[42.62105,12.39313,519],[42.62094,12.39356,513],[42.62079,12.39372,512],[42.62053,12.39384,511],[42.62052,12.39392,510],[42.62058,12.39397,509],[42.62078,12.39397,506],[42.62098,12.39398,504],[42.62091,12.39406,504],[42.62066,12.39413,506],[42.62053,12.39439,503],[42.62057,12.39465,497],[42.6206,12.39492,494],[42.62076,12.39531,492],[42.62063,12.39559,490],[42.62079,12.39599,487],[42.62096,12.39638,486],[42.62096,12.3965,487],[42.62083,12.39672,484],[42.62077,12.39717,481],[42.6207,12.39761,476],[42.62057,12.39798,471],[42.62044,12.39834,470],[42.62032,12.39871,472],[42.62019,12.39907,475],[42.62018,12.39947,476],[42.62003,12.39982,476],[42.62006,12.40012,475],[42.62018,12.40021,474],[42.62043,12.40056,467],[42.62035,12.40089,469],[42.62024,12.40115,470],[42.62015,12.40124,471],[42.6199,12.4013,472],[42.61965,12.40135,471],[42.61939,12.40141,468],[42.61921,12.40153,465],[42.6191,12.40195,465],[42.61899,12.40237,460],[42.61883,12.40261,456],[42.61867,12.40285,456],[42.61863,12.403,456],[42.61865,12.4032,456],[42.61877,12.40353,455],[42.61876,12.40369,453],[42.6187,12.4038,451],[42.61853,12.4039,449],[42.61837,12.404,446],[42.61815,12.40424,445]]],"extras":[],"desc":"È il più lungo dei tre anelli di Collicello e ne condivide la partenza: da Porta Vecchia e dalle chiese di Santa Maria delle Grazie e di San Giovanni Evangelista si sale su sentiero allo Speco Francescano, alla grotta e ai ruderi del convento benedettino (km 1,6). Si prosegue su carrareccia lungo la strada di Gallisciano, si incrocia il 719 al km 3,8 e con un'ultima salita di circa 90 m si arriva al punto più alto al km 5,5. Il ritorno è lungo e graduale, circa 160 m di discesa in 4 km tutti su sterrato, con la Voragine Cannetto Sponnorato poco discosta al km 6; negli ultimi 2 km, in comune con il 723, si rientra in paese per la strada asfaltata di Frattuccia.\n\nFa parte della rete escursionistica dei Sentieri Amerini, sui monti e le colline attorno ad Amelia.\n\nCollicello, borgo di Amelia tra i boschi, nacque verso il 1295 per accogliere gli abitanti di castelli vicini passati sotto Amelia. Nel Quattrocento fu il caposaldo amerino contro i Chiaravalle, signori del vicino castello di Canale: dal torrione una bombarda tirava sulle mura nemiche. Canale fu espugnato nel 1462 e oggi ne restano le rovine."}